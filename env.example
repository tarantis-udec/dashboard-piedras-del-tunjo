# Copie este archivo como .env (no lo suba a repositorios) y ajuste los valores.
# Si no define una variable, se usa el valor por defecto de config.py.

# Opción A: archivo Excel o CSV (carpeta data/ por defecto)
PARQUE_DATA_DIR=data
PARQUE_DATA_FILE=Dataset_parque_piedras_del_tunjo_v3.xlsx

# Opción B: base SQL (si se define, tiene prioridad sobre el archivo)
# PARQUE_DB_URL=mysql+pymysql://usuario:clave@localhost:3306/parque_tunjo

# Servidor
APP_HOST=127.0.0.1
APP_PORT=8050
